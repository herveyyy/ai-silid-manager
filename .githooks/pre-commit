#!/bin/sh
# Runs before every `git commit`. Blocks the commit if the build fails.
# Skip once: git commit --no-verify -m "message"

set -e

cd "$(git rev-parse --show-toplevel)"

if ! command -v bun >/dev/null 2>&1; then
  echo "pre-commit: bun not found in PATH. Install Bun or commit with --no-verify."
  exit 1
fi

echo "pre-commit: running bun run build..."
bun run build
echo "pre-commit: build passed."
